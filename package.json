{
  "name": "fifo-wealth-os-core",
  "version": "1.0.0",
  "description": "Production-grade Core FIFO Engine for FIFO Wealth OS",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "dev": "tsx watch src/api/server.ts",
    "start": "node dist/api/server.js",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit && cd fifo-wealth-os-web && npm run lint",
    "test": "jest --runInBand --verbose",
    "test:coverage": "jest --runInBand --coverage",
    "build:check": "npm run typecheck && cd fifo-wealth-os-web && npm run typecheck && npm run lint && cd .. && npm test",
    "prisma:migrate": "prisma migrate dev",
    "generate:sample-report": "npm run build && node dist/scripts/generateSampleReport.js"
  },
  "keywords": [
    "fintech",
    "fifo",
    "wealth-os",
    "portfolio",
    "accounting",
    "typescript"
  ],
  "license": "MIT",
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.6",
    "decimal.js": "^10.6.0",
    "express": "^4.22.3",
    "fast-xml-parser": "^5.11.2",
    "fflate": "^0.8.3",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.5.0",
    "pdfkit": "^0.20.2",
    "seedrandom": "^3.0.5",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^20.19.37",
    "@types/pdfkit": "^0.17.7",
    "@types/seedrandom": "^3.0.8",
    "@types/supertest": "^6.0.3",
    "@types/swagger-ui-express": "^4.1.8",
    "jest": "^30.5.2",
    "msw": "^1.3.5",
    "prisma": "^5.22.0",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.15",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "msw": {
      "cookie": "0.7.2"
    }
  }
}
