{
  "info": {
    "name": "FIFO Wealth OS - Backend REST API",
    "description": "Complete Postman Collection for FIFO Wealth OS (Authentication, Multi-Portfolio, Multi-Asset, Bloomberg file mapping, advanced Options/REIT/Private Equity/Futures calculators, FX, Thai tax, reports and Open Beta billing).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "portfolioId",
      "value": ""
    },
    {
      "key": "transactionId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. Authentication",
      "item": [
        {
          "name": "Register User",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"investor@wealthos.th\",\n  \"password\": \"SecurePass123!\",\n  \"name\": \"คุณสมชาย นักลงทุน\"\n}"
            }
          }
        },
        {
          "name": "Login User",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"investor@wealthos.th\",\n  \"password\": \"SecurePass123!\"\n}"
            }
          }
        },
        {
          "name": "Get Current User (/me)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/api/auth/me"
          }
        }
      ]
    },
    {
      "name": "2. Portfolio Management",
      "item": [
        {
          "name": "List Portfolios",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/api/portfolios"
          }
        },
        {
          "name": "Create Portfolio",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/portfolios",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Global Equity & Crypto\",\n  \"baseCurrency\": \"THB\"\n}"
            }
          }
        },
        {
          "name": "Get Portfolio Details",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/api/portfolios/{{portfolioId}}"
          }
        },
        {
          "name": "Delete Portfolio",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/api/portfolios/{{portfolioId}}"
          }
        }
      ]
    },
    {
      "name": "3. Multi-Asset Foundation",
      "item": [
        {
          "name": "Get Multi-Asset Summary",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/api/multi-assets/portfolios/{{portfolioId}}?asOfDate=2026-10-27&taxYear=2026"
          }
        },
        {
          "name": "Create Bond Transaction (CDM)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/multi-assets/portfolios/{{portfolioId}}/transactions",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"date\": \"2026-10-01\",\n  \"symbol\": \"BOND-TH-2028\",\n  \"assetClass\": \"BOND\",\n  \"type\": \"BUY\",\n  \"qty\": 10,\n  \"price\": \"1000.00\",\n  \"gross\": \"10000.00\",\n  \"comm\": \"0.00\",\n  \"vat\": \"0.00\",\n  \"net\": \"10000.00\",\n  \"originalCurrency\": \"THB\",\n  \"originalNet\": \"10000.00\",\n  \"fxRate\": \"1.00000000\",\n  \"netTHB\": \"10000.00\",\n  \"bondExtension\": {\n    \"couponRate\": \"0.05\",\n    \"paymentFrequency\": \"SEMI_ANNUAL\",\n    \"maturityDate\": \"2028-10-01\",\n    \"faceValue\": \"1000.00\",\n    \"accruedInterest\": \"0.00\"\n  }\n}"
            }
          }
        },
        {
          "name": "Delete Multi-Asset Transaction",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/api/multi-assets/portfolios/{{portfolioId}}/transactions/{{transactionId}}"
          }
        }
      ]
    },
    {
      "name": "4. File Upload & Transactions",
      "item": [
        {
          "name": "Upload Trade CSV (Bitkub / IBKR)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/api/upload/csv",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": ""
                },
                {
                  "key": "portfolioId",
                  "value": "{{portfolioId}}",
                  "type": "text"
                },
                {
                  "key": "exchange",
                  "value": "IBKR",
                  "type": "text"
                }
              ]
            }
          }
        },
        {
          "name": "Get Portfolio Transactions",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/api/transactions/{{portfolioId}}"
          }
        },
        {
          "name": "Upload Dividends CSV",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/api/upload/dividends",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": ""
                },
                {
                  "key": "portfolioId",
                  "value": "{{portfolioId}}",
                  "type": "text"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "5. Tax & Reports",
      "item": [
        {
          "name": "Get Annual Tax Summary (JSON)",
